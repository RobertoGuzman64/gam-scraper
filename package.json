{
  "name": "equipzilla-scraper",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=18.18.0"
  },
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "tsc -p tsconfig.json",
    "scrape": "npm run build && node dist/cli/scrape.js",
    "normalize:gam": "npm run build && node dist/tools/gam/normalize-csv.js",
    "normalize:gam:default": "npm run build && node dist/tools/gam/normalize-csv.js storage/scraped/gam/scrape-gam-marzo-2026-all.csv storage/normalized/gam/scrape-gam-marzo-2026-all.normalized.csv --report storage/normalized/gam/normalize.report.json",
    "convert:gam": "npm run build && node dist/tools/gam/seed/convert-csv.js",
    "convert:gam:raw:default": "npm run build && node dist/tools/gam/seed/convert-csv.js storage/scraped/gam/scrape-gam-marzo-2026-all.csv storage/seeds/seedDataProduct.gam.ts data/category/categorySell-flat.json",
    "convert:gam:default": "npm run build && node dist/tools/gam/seed/convert-csv.js storage/normalized/gam/scrape-gam-marzo-2026-all.normalized.csv storage/seeds/seedDataProduct.gam.ts data/category/categorySell-flat.json",
    "category:tree": "npm run build && node dist/tools/gam/seed/convert-csv-by-category.js",
    "slugs:gam": "npm run build && node dist/tools/gam/seed/convert-csv-by-url.js",
    "test": "npm run build && node --test",
    "scrape:all": "npm run build && node dist/cli/batch.js",
    "export:import": "npm run build && node dist/cli/export.js",
    "validate:catalog": "npm run build && node dist/cli/validate.js"
  },
  "dependencies": {
    "cheerio": "^1.0.0",
    "p-limit": "^6.2.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.6.0"
  }
}
