    "editorial:auditar-cobertura": "node scripts/build/run-build.mjs --quiet --if-needed && node scripts/operations/audit-editorial-coverage.mjs",
    "auditar:bateria": "node scripts/inspection/audit-battery.mjs",
    "diagnosticar:finish": "node scripts/inspection/finish-preflight.mjs"
