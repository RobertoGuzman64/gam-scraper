    "editorial:auditar-fase5": "node scripts/run-build.mjs --quiet --if-needed && node scripts/operations/audit-editorial-phase4.mjs --phase5",
    "editorial:auditar-residual": "node scripts/operations/audit-editorial-residual.mjs"
